---
import Layout from '../layouts/Layout.astro';

// Interview data - newest first
const interviews = [
  {
    id: 's6q-Zx6eZZc',
    title: 'Най-ново интервю',
    channel: 'Ново',
    featured: true,
  },
  {
    id: 'QvJfXTKiNSc',
    title: 'Най-ново интервю',
    channel: 'Ново',
    featured: true,
  },
  {
    id: 'JBRJTWEzGik',
    title: 'ПРИЯТЕЛ за ЦЕЛИ с Иван Цукев',
    channel: 'LIMITLESS',
  },
  {
    id: 'OgltGWhYiOY',
    title: 'Маркетинг автоматизации',
    channel: 'Xplore Marketing',
  },
  {
    id: 'c7jmJqrkSSs',
    title: 'Как да оптимизираш живота и бизнеса си',
    channel: 'Да Убиеш Дракона',
  },
  {
    id: '-Fz42iA6c_8',
    title: 'Как да откриеш своите цели и да създадеш своята визия',
    channel: 'Свръхчовекът',
  },
  {
    id: 'x5PQhHTcjLA',
    title: 'Трите ключа за оптимизиране на енергията',
    channel: 'Закуска с подкаст',
  },
  {
    id: 'RMq-pYgEhxs',
    title: 'На гости ми е Иван Цукев',
    channel: 'Юли Тонкин',
  },
  {
    id: 'JZWoJ0M5hT4',
    title: 'Как правилно да поставим целите пред себе си?',
    channel: 'Break Point',
  },
  {
    id: 'DQquZ7E4SEE',
    title: 'Правете нещата, които ви генерират повече енергия',
    channel: 'Tedi.Stories',
  },
];

const featuredInterviews = interviews.filter(i => i.featured);
const regularInterviews = interviews.filter(i => !i.featured);
---

<Layout title="Интервюта | Иван Цукев" description="Медийни появи, подкасти и телевизионни интервюта с Иван Цукев за предприемачество, целеполагане и AI.">

  <!-- Hero Section -->
  <section class="relative min-h-[50vh] flex flex-col justify-center items-center text-center mb-16 overflow-hidden">
    <!-- Cinematic gradient backdrop -->
    <div class="absolute inset-0 bg-gradient-to-b from-accent/5 via-transparent to-transparent"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-radial from-accent/10 via-accent-secondary/5 to-transparent blur-3xl"></div>

    <!-- Decorative film grain overlay -->
    <div class="absolute inset-0 opacity-[0.015] mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.8%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27/%3E%3C/svg%3E');"></div>

    <!-- Horizontal decorative lines -->
    <div class="absolute top-1/4 left-0 right-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"></div>
    <div class="absolute bottom-1/4 left-0 right-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"></div>

    <div class="relative z-10 opacity-0 animate-fade-in-up">
      <!-- Eyebrow -->
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="w-12 h-px bg-accent"></span>
        <span class="text-accent font-display text-xs tracking-[0.3em] uppercase">Медийни появи</span>
        <span class="w-12 h-px bg-accent"></span>
      </div>

      <!-- Main headline -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 tracking-tight">
        <span class="block text-text-primary">Интервюта &</span>
        <span class="block gradient-text">Подкасти</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-text-secondary text-lg md:text-xl max-w-xl mx-auto leading-relaxed">
        Разговори за предприемачество, целеполагане, AI и бъдещето на технологиите
      </p>

    </div>
  </section>

  <!-- Featured Section -->
  {featuredInterviews.length > 0 && (
    <section class="max-w-5xl mx-auto mb-20">
      <div class="opacity-0 animate-fade-in-up stagger-2">
        <div class="flex items-center gap-4 mb-8">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
            </span>
            <span class="section-label !mb-0">Най-нови</span>
          </div>
          <div class="flex-1 h-px bg-gradient-to-r from-accent/50 to-transparent"></div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6 opacity-0 animate-fade-in-up stagger-3">
        {featuredInterviews.map((interview, index) => (
          <div class="video-card featured group">
            <div class="relative">
              <!-- Glow effect -->
              <div class="absolute -inset-1 bg-gradient-to-r from-accent/20 to-accent-secondary/20 rounded-xl blur-lg opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

              <div class="relative bg-bg-secondary rounded-xl overflow-hidden border border-accent/30">
                <!-- Video embed -->
                <div class="aspect-video">
                  <iframe
                    src={`https://www.youtube.com/embed/${interview.id}`}
                    title={interview.title}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    class="w-full h-full"
                    loading="lazy"
                  ></iframe>
                </div>

                <!-- Info bar -->
                <div class="p-4 border-t border-border/50">
                  <div class="flex items-center justify-between">
                    <span class="inline-flex items-center gap-2 text-xs font-display font-medium text-accent">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M23 12l-7.071 7.071-1.414-1.414L20.172 12l-5.657-5.657 1.414-1.414L23 12zM3.828 12l5.657 5.657-1.414 1.414L1 12l7.071-7.071 1.414 1.414L3.828 12z"/>
                      </svg>
                      {interview.channel}
                    </span>
                    <span class="text-xs text-text-muted font-display">Ново</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- All Interviews Grid -->
  <section class="max-w-5xl mx-auto">
    <div class="opacity-0 animate-fade-in-up stagger-4">
      <div class="flex items-center gap-4 mb-8">
        <span class="section-label !mb-0">Архив</span>
        <div class="flex-1 h-px bg-gradient-to-r from-border to-transparent"></div>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 opacity-0 animate-fade-in-up stagger-5">
      {regularInterviews.map((interview, index) => (
        <div class="video-card group">
          <div class="relative bg-bg-secondary rounded-lg overflow-hidden border border-border/50 transition-all duration-300 hover:border-accent/30 hover:shadow-[0_0_30px_-10px_rgba(74,158,255,0.3)]">
            <!-- Video embed -->
            <div class="aspect-video">
              <iframe
                src={`https://www.youtube.com/embed/${interview.id}`}
                title={interview.title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="w-full h-full"
                loading="lazy"
              ></iframe>
            </div>

            <!-- Info -->
            <div class="p-4">
              <h3 class="text-sm font-display font-medium text-text-primary mb-2 line-clamp-2 group-hover:text-accent transition-colors">
                {interview.title}
              </h3>
              <div class="flex items-center gap-2 text-xs text-text-muted font-display">
                <svg class="w-3.5 h-3.5 text-red-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0C.488 3.45.029 5.804 0 12c.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0C23.512 20.55 23.971 18.196 24 12c-.029-6.185-.484-8.549-4.385-8.816zM9 16V8l8 3.993L9 16z"/>
                </svg>
                {interview.channel}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="max-w-prose mx-auto mt-20 text-center opacity-0 animate-fade-in-up" style="animation-delay: 0.6s;">
    <div class="relative p-8 rounded-2xl border border-border/50 bg-bg-secondary/50 backdrop-blur-sm">
      <!-- Decorative corner accents -->
      <div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-accent/40 rounded-tl-2xl"></div>
      <div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-accent-secondary/40 rounded-br-2xl"></div>

      <h2 class="text-xl font-display font-semibold text-text-primary mb-3">
        Искате интервю?
      </h2>
      <p class="text-text-secondary mb-6">
        Отворен съм за подкасти, панели и медийни участия по теми свързани с AI, предприемачество и онлайн образование.
      </p>
      <a href="/за-мен/" class="btn-primary">
        Свържете се с мен
      </a>
    </div>
  </section>

</Layout>

<style>
  .video-card {
    --stagger: calc(var(--index, 0) * 0.05s);
    animation: cardFadeIn 0.5s ease-out calc(var(--stagger)) both;
  }

  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .video-card:nth-child(1) { --index: 1; }
  .video-card:nth-child(2) { --index: 2; }
  .video-card:nth-child(3) { --index: 3; }
  .video-card:nth-child(4) { --index: 4; }
  .video-card:nth-child(5) { --index: 5; }
  .video-card:nth-child(6) { --index: 6; }
  .video-card:nth-child(7) { --index: 7; }
  .video-card:nth-child(8) { --index: 8; }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
