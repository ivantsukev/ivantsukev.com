---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Успешен абонамент | Иван Цукев" description="Благодаря за абонамента!">
  <div class="max-w-prose mx-auto min-h-[60vh] flex flex-col items-center justify-center text-center">
    <!-- Success animation -->
    <div class="relative mb-8 opacity-0 animate-fade-in-up">
      <!-- Glow background -->
      <div class="absolute inset-0 bg-accent/20 rounded-full blur-2xl scale-150"></div>

      <!-- Checkmark circle -->
      <div class="relative w-24 h-24 rounded-full bg-gradient-to-br from-accent to-accent-secondary flex items-center justify-center">
        <svg class="w-12 h-12 text-bg-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
        </svg>
      </div>
    </div>

    <div class="opacity-0 animate-fade-in-up stagger-2">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">Благодаря!</h1>
      <p class="text-text-secondary text-lg mb-8 max-w-md">
        Абонаментът ти е успешен. Ще получаваш мислите ми за AI и бъдещето директно в пощата си.
      </p>
    </div>

    <div class="opacity-0 animate-fade-in-up stagger-3">
      <a href="/" class="btn-ghost">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        Към началната страница
      </a>
    </div>
  </div>
</Layout>
