---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Страницата не е намерена | Иван Цукев" description="Тази страница не съществува.">
  <section class="max-w-prose mx-auto text-center py-24">
    <p class="section-label">404</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6">Страницата не е намерена</h1>
    <p class="text-text-secondary text-lg mb-10">
      Може да си проследил остарял линк или да си сбъркал URL.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="/" class="btn-primary">Към началото</a>
      <a href="/statii" class="btn-ghost">Към статиите</a>
    </div>
  </section>
</Layout>
